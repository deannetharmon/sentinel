# Copy these into your hosting project's environment variables. Never commit real values.

# Redis for Sentinel's own state (its own database or instance, not TradeEdge's)
REDIS_URL=

# Sentinel's own read-only tastytrade OAuth application
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=

# Long random strings you choose
SENTINEL_ADMIN_SECRET=
SENTINEL_CRON_SECRET=
